;; ============================================================================
;; Kanata config migrated from kmonad mauMap.kbd
;; Source: https://github.com/maubuz/mau-kmonad/blob/main/user/mauedu/mauMap.kbd
;;
;;
;; Stowed to ~/.config/kanata/ and run without root as a systemd user service:
;;   systemctl --user start kanata.service
;; Validate before restarting:
;;   kanata --cfg ~/.config/kanata/mauMap.kanata.kbd --check
;; Install and troubleshooting: ansible-homelab/workstation/11_kanata.md
;; ============================================================================

(defcfg
  ;; --- Input / Output ---------------------------------------------------------
  ;; Linux: ThinkPad T14 built-in keyboard
  linux-dev /dev/input/by-path/platform-i8042-serio-0-event-kbd

  ;; Logitech G410
  ;; linux-dev /dev/input/by-id/usb-Logitech_Gaming_Keyboard_G410_018836623538-event-kbd

  ;; Lenovo keyboard (Hugh's)
  ;; linux-dev /dev/input/by-id/usb-LITE-ON_Technology_USB_NetVista_Full_Width_Keyboard.-event-kbd

  ;; For Windows, replace the linux-dev line above with:
  ;; windows-altgr add-lctl-release      ;; only if you use AltGr
  ;; (kanata auto-detects keyboards on Windows)

  ;; Name of the virtual output device (replaces kmonad's uinput-sink name)
  linux-output-device-name "My Kanata output"

  ;; Process keys not in defsrc too. Recommended for tap-hold-release timing.
  process-unmapped-keys yes

  ;; -----------------------------------------------------------------------------
  ;; NOTE 1 (Menu key, and why no xkb options are needed):
  ;; This config runs on a stock GNOME desktop:
  ;;   org.gnome.desktop.input-sources xkb-options  ->  []   (the Ubuntu default)
  ;;
  ;; The arrows layer emits `cmps` on the `y` position. Despite the name that is
  ;; evdev KEY_COMPOSE (127), which xkb aliases to <MENU>, and the stock keymap
  ;; binds it to the Menu keysym — so it opens the context menu with no
  ;; configuration at all. Confirm with:
  ;;   setxkbmap -layout us -print | xkbcomp -xkb - - | grep '<COMP>'
  ;;   ->  key <COMP> { [ Menu ] };
  ;;
  ;; Do NOT set the `compose:menu` xkb option. It rebinds <MENU> to Multi_key at
  ;; every level, and the Menu key stops working — one keycode cannot be both.
  ;; A compose key has to live on a keycode kanata never emits; every other
  ;; candidate GNOME offers collides with a home row mod below (ralt/lwin/rwin/
  ;; rctrl) or is unreachable (caps is remapped to esc), leaving only
  ;; compose:sclk. We skip compose entirely and type accented characters from
  ;; the br / ca input sources, which carry them natively.
  ;;
  ;; Kanata has no equivalent of kmonad's
  ;;     output (uinput-sink "..." "<shell command>")
  ;; nor of `cmp-seq ralt` / `cmp-seq-delay 5`, and its `unicode` action is
  ;; unreliable on Wayland, so compose cannot be moved into kanata either.
  ;;
  ;; NOTE 2 (allow-cmd):
  ;; Kanata's `cmd` action only exists when the binary was compiled with
  ;; `--features cmd`. The default build cannot run shell commands, so this
  ;; matches your kmonad `allow-cmd false` setting without any extra option.
  ;; -----------------------------------------------------------------------------
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '
       z    x    c    v    b    n    m    ,    .    /
  spc
)

;; --- Simple action aliases (1:1 with your kmonad defalias) -------------------
(defalias
  cp  C-c
  pt  C-v
  cut C-x
  all C-a
  cwn A-f4
  ctb C-w
  un  C-z
  re  C-y
  ;; Deliberately unbound — kept as the alternative to `cmps` on `y`.
  ;; Shift+F10 is the toolkit-level "show context menu" convention (GTK and Qt
  ;; bind it to the same popup-menu action as the Menu key), so unlike `cmps` it
  ;; cannot be taken away by an xkb option. Bind it in the arrows layer if you
  ;; ever want a compose key on the us layout: `compose:menu` would then claim
  ;; keycode 127 for Multi_key, and @mnu gives back the context menu. Caveat —
  ;; apps that only listen for the Menu keysym ignore it, and some bind Shift+F10
  ;; to something else entirely (JetBrains IDEs use it for Run).
  mnu S-f10
  cHm C-home

  arr (layer-toggle arrows)
)

;; --- Home row mods -----------------------------------------------------------
;; kmonad : (tap-hold-next-release TIMEOUT TAP HOLD)
;; kanata : (tap-hold-release TAP-TIME HOLD-TIME TAP HOLD)
;; We pass the same value to both timeouts to mimic the single-timeout kmonad
;; semantics most closely. You can later split them or migrate to chordsv2.
(defalias
  m_a (tap-hold-release 180 180 a lmet)
  a_s (tap-hold-release 160 160 s lalt)
  c_d (tap-hold-release 160 160 d rctl)
  s_f (tap-hold-release 130 130 f rsft)
  s_j (tap-hold-release 130 130 j rsft)
  c_k (tap-hold-release 160 160 k rctl)
  ;; lalt, not ralt: Right Alt is AltGr in the br / ca layouts, so an `ralt` hold
  ;; would emit level-3 characters there instead of Alt. Emitting lalt leaves the
  ;; physical Right Alt free to stay a real AltGr — no lv3:ralt_alt xkb option.
  a_l (tap-hold-release 160 160 l lalt)
  m_; (tap-hold-release 180 180 ; rmet)
  s_1 (tap-hold-release 160 160 spc @arr)
)

(deflayer homeMods
  grv  1    2    3    4    5    6    7    8    9    0    -    =
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  esc  @m_a @a_s @c_d @s_f g    h    @s_j @c_k @a_l @m_; '
       z    x    c    v    b    n    m    ,    .    /
  @s_1
)

(deflayer arrows
  _    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  _    _    @ctb @cwn _    @cHm cmps pgup up   pgdn _    _    _    _
  _    @all _    _    _    _    home left down rght end  _
       @un  @cut @cp  @pt  c    bspc del  @un  @re  _
  _
)

;; `cmps` on the `y` position is the Menu key — see NOTE 1 in defcfg.
;; Test with: hold spc, tap y  -> the context menu opens.
;; kanata's `menu` / `apps` names are not a substitute: they emit KEY_MENU (139),
;; which xkb maps to XF86MenuKB, and nothing is bound to that.
